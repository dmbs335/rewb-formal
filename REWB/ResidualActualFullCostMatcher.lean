import REWB.ResidualActualFullCostDispatch
import REWB.ResidualActualFullCostIndependent
import REWB.ResidualActualMatcher

/-! Actual construction-counted dispatch for all six normalized forms.
Every nested row bank is generated by FullCost.inputs; every periodic
branch is executed through PeriodicActual. Independent captures use two
FullCost rows and their regular-gap aggregate. No row, split, answer or
cost oracle is an executable input.

The fixed-pattern normalizer may be compiled once and reused through
run. Returned counters combine the documented transition/comparison
ledgers with the new construction operations; they are not machine-bit,
reference-counting, allocator or garbage-collector costs. -/
namespace REWB.ResidualActual.FullCost.Matcher
open REWB.CompleteNormalization (Form)
variable {σ : Nat}

set_option maxRecDepth 4096
set_option maxHeartbeats 4000000

structure Execution where
  answer : Bool
  accountedWork : Nat
  fixedPatternBuilds : Nat

def form : Form (Fin σ)→Array (Fin σ)→Fin σ→Execution
  | .regular A,text,_ =>
    ⟨A.final (A.run A.initial text.toList),3*text.size+5,0⟩
  | .once A B C E,text,fallback =>
    let out:=FullCost.P2.auto (ResidualActual.oncePattern A B C E) text fallback
    ⟨out.answer,out.accountedWork+3,out.fixedPatternBuilds⟩
  | .sameValue P,text,fallback =>
    let out:=FullCost.P1.auto (ResidualActual.samePattern P) text fallback
    ⟨out.answer,out.accountedWork+3,out.fixedPatternBuilds⟩
  | .independent P,text,fallback =>
    let out:=FullCost.Independent.execute P text fallback
    ⟨out.1.answer,out.2+3,out.1.fixedPatternBuilds⟩
  | .nested1 P,text,fallback =>
    let out:=FullCost.P1.auto P text fallback
    ⟨out.answer,out.accountedWork+3,out.fixedPatternBuilds⟩
  | .nested2 P,text,fallback =>
    let out:=FullCost.P2.auto P text fallback
    ⟨out.answer,out.accountedWork+3,out.fixedPatternBuilds⟩

theorem form_answer (F : Form (Fin σ)) (text : Array (Fin σ)) (fallback : Fin σ) :
    (form F text fallback).answer=(ResidualActual.Matcher.form F text fallback).answer := by
  cases F with
  | regular A=>rfl
  | once A B C E=>
    change (FullCost.P2.auto (ResidualActual.oncePattern A B C E) text fallback).answer=
      (ResidualActual.P2.auto (ResidualActual.oncePattern A B C E) text fallback).answer
    rw [FullCost.P2.auto_answer,Periodic.P2.auto_answer]
  | sameValue P=>
    change (FullCost.P1.auto (ResidualActual.samePattern P) text fallback).answer=
      (ResidualActual.P1.auto (ResidualActual.samePattern P) text fallback).answer
    rw [FullCost.P1.auto_answer,Periodic.P1.auto_answer]
  | independent P=>
    change (FullCost.Independent.execute P text fallback).1.answer=
      (ResidualActual.Independent.execute P text fallback).answer
    rw [FullCost.Independent.execute_value]
  | nested1 P=>
    change (FullCost.P1.auto P text fallback).answer=(ResidualActual.P1.auto P text fallback).answer
    rw [FullCost.P1.auto_answer,Periodic.P1.auto_answer]
  | nested2 P=>
    change (FullCost.P2.auto P text fallback).answer=(ResidualActual.P2.auto P text fallback).answer
    rw [FullCost.P2.auto_answer,Periodic.P2.auto_answer]

theorem form_correct (F : Form (Fin σ)) (text : Array (Fin σ)) (fallback : Fin σ) :
    (form F text fallback).answer=true ↔ MatchesWithin F.expr text.toList 2 := by
  rw [form_answer]
  exact ResidualActual.Matcher.form_correct F text fallback

abbrev Compiled (σ : Nat) := List (Form (Fin σ))

def compile (p : Expr (Fin σ)) : Compiled σ := CompleteNormalization.forms p

def run (compiled : Compiled σ) (text : Array (Fin σ)) (fallback : Fin σ) : Execution :=
  match compiled with
  | [] => ⟨false,1,0⟩
  | F::rest =>
    let one:=form F text fallback
    let tail:=run rest text fallback
    ⟨one.answer || tail.answer,one.accountedWork+tail.accountedWork+3,
      one.fixedPatternBuilds+tail.fixedPatternBuilds⟩

theorem run_correct (compiled : Compiled σ) (text : Array (Fin σ)) (fallback : Fin σ) :
    (run compiled text fallback).answer=true ↔ ∃F,F∈compiled ∧ MatchesWithin F.expr text.toList 2 := by
  induction compiled with
  | nil => simp [run]
  | cons F rest ih => simp only [run,Bool.or_eq_true,form_correct,ih,List.mem_cons,exists_eq_or_imp]

theorem run_answer (compiled : Compiled σ) (text : Array (Fin σ)) (fallback : Fin σ) :
    (run compiled text fallback).answer=(ResidualActual.Matcher.run compiled text fallback).answer := by
  induction compiled with
  | nil => rfl
  | cons F rest ih => simp only [run,ResidualActual.Matcher.run,form_answer,ih]

theorem run_work (compiled : Compiled σ) (text : Array (Fin σ)) (fallback : Fin σ) :
    (run compiled text fallback).accountedWork=
      (compiled.map fun F=>(form F text fallback).accountedWork+3).sum+1 := by
  induction compiled with
  | nil => rfl
  | cons F rest ih =>
    simp only [run,List.map_cons,List.sum_cons,ih]
    omega

theorem run_builds (compiled : Compiled σ) (text : Array (Fin σ)) (fallback : Fin σ) :
    (run compiled text fallback).fixedPatternBuilds=
      (compiled.map fun F=>(form F text fallback).fixedPatternBuilds).sum := by
  induction compiled with
  | nil => rfl
  | cons F rest ih => simp only [run,List.map_cons,List.sum_cons,ih]

def solve (p : Expr (Fin σ)) (text : Array (Fin σ)) (fallback : Fin σ) : Execution :=
  run (compile p) text fallback

theorem solve_correct (p : Expr (Fin σ)) (text : Array (Fin σ)) (fallback : Fin σ) :
    (solve p text fallback).answer=true ↔ MatchesWithin p text.toList 2 := by
  rw [solve,run_correct]
  exact (CompleteNormalization.forms_correct p text.toList).symm

theorem solve_answer (p : Expr (Fin σ)) (text : Array (Fin σ)) (fallback : Fin σ) :
    (solve p text fallback).answer=(ResidualActual.Matcher.solve p text fallback).answer :=
  run_answer (compile p) text fallback

def matchWord (p : Expr (Fin σ)) (fallback : Fin σ) (w : Word (Fin σ)) : Bool :=
  (solve p w.toArray fallback).answer

theorem matchWord_correct (p : Expr (Fin σ)) (fallback : Fin σ) (w : Word (Fin σ)) :
    matchWord p fallback w=true ↔ MatchesWithin p w 2 := by
  simpa only [matchWord,List.toList_toArray] using solve_correct p w.toArray fallback

theorem correctMatcher (p : Expr (Fin σ)) (fallback : Fin σ) :
    Spec.CorrectMatcher p (matchWord p fallback) := matchWord_correct p fallback

end REWB.ResidualActual.FullCost.Matcher
